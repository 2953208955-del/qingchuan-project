# 复制为 .env.local（本地）或 .env（服务器），填入真实密钥。
# 本文件只保留空值，禁止写入真实密钥，禁止提交 .env / .env.local。

# 必填：文本报告（DeepSeek）
DEEPSEEK_API_KEY=
# 必填：视觉识别、Embedding、Rerank（DashScope）
DASHSCOPE_API_KEY=
# 可选：视觉备选供应商
ZHIPU_API_KEY=

# 数据目录：SQLite 与上传图片都放在这里。
# 本地默认 ./data；生产建议 /opt/qingchuan/data。
DATA_DIR=./data
APP_BASE_URL=http://localhost:3000

# 单次任务与每日预算上限（元）
RUN_BUDGET_CNY=1.0
DAILY_BUDGET_CNY=20

# 模型名（默认值见 src/lib/ai/models.ts；账号可用模型不同时在此覆盖）
VISION_MODEL=qwen3-vl-plus
TEXT_MODEL=deepseek-chat
EMBEDDING_MODEL=qwen3.7-text-embedding
RERANK_MODEL=qwen3.7-text-rerank
